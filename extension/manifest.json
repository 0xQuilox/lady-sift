{
  "manifest_version": 3,
  "name": "Lady Sift",
  "version": "0.1.0",
  "description": "On-device real vs AI-generated image detector (MobileNetV2, 100% local).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lady Sift",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "offscreen", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/tfjs_model/*", "src/offscreen/*", "src/sandbox/*", "libs/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["src/sandbox/sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
